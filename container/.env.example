# Prefer `./setup.sh --container` (or `./container/bootstrap.sh`) over
# copying this by hand -- it writes offices/<pod>/<tenant>/.env for you and
# always runs `docker compose` with an explicit, per-office project name
# (see compose.yaml's own header comment for why that matters once more
# than one office is ever deployed). This file is a reference for what an
# office's env file contains, and a convenience default (as container/.env)
# for a single-office/testing setup where that isolation doesn't matter --
# see README.md's "Bootstrap script" section for the complete set of
# non-interactive variables setup.sh reads.

POD=default
TENANT=default

# Comma-separated agent names -- the first is the office lead (see setup.sh's
# wizard). Every agent hired this way runs claude by default; use AGENT_CLIS
# below for exceptions.
AGENTS=architect

# claude | codex | agy
DEFAULT_CLI=claude

# Required for a claude agent to do anything beyond a first-run login
# prompt. One token per account name in ACCOUNTS (default: "default").
# CLAUDE_OAUTH_TOKEN_DEFAULT=

# Per-agent exceptions only, comma-separated agent=value pairs -- leave
# blank for a uniform office. See README.md for the exact format and why a
# typo in AGENT_PROVIDERS specifically means real spend, not a silent skip.
# AGENT_CLIS=
# AGENT_PROFILES=
# AGENT_PROVIDERS=

# TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID together enable the REST API,
# Telegram bot, AND session (terminal-watch) daemons -- there is no separate
# "enable the API" setting (see services/daemons.py's enabled_daemon_modules).
# API_TOKEN is required once they're enabled.
# API_TOKEN=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_VOICE=0

# The api and session doors both bind 0.0.0.0 *inside* this container
# unconditionally (see container/Dockerfile) and refuse to start with that
# bind unless they have real TLS certs or an explicit plaintext
# acknowledgment -- entrypoint.sh checks this up front and refuses to boot
# at all rather than crash-loop if neither is set while Telegram is
# configured. Set ONE of these two:
# API_TLS_CERT=
# API_TLS_KEY=
# (SESSION_TLS_CERT/SESSION_TLS_KEY only if the session door needs a
# different cert than the api door -- it falls back to API_TLS_CERT/KEY
# otherwise)
#
# ...or, for a tenant that's only reachable over a private network, an SSH
# tunnel, or a TLS-terminating reverse proxy already in front -- not
# genuinely exposed in the clear -- accept that explicitly instead:
# H_MESH_ALLOW_PLAINTEXT=1

# Host-side published ports (compose.yaml maps these onto the container's
# always-8080/8081 internal doors -- see container/Dockerfile's API_BIND/
# SESSION_BIND comment for why those are fixed).
API_PORT=8080
SESSION_PORT=8081
